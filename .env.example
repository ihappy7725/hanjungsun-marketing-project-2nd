# [PM1 상준만 수정] 이름만 적고 실제 값은 넣지 않습니다.
# 각자 이 파일을 .env로 복사한 뒤 실제 값을 채웁니다. .env는 Git에 올리지 않습니다. (README 9장)

# 공통
SECRET_KEY=change-me

# 인플루언서 마케팅 (진혁)
YOUTUBE_API_KEY=
PHYLLO_CLIENT_ID=
PHYLLO_CLIENT_SECRET=
PHYLLO_ENV=sandbox

# 콘텐츠 스튜디오 (유진) — Higgsfield 영상 생성
HF_API_KEY_ID=
HF_API_KEY_SECRET=
PUBLIC_BASE_URL=

# 콘텐츠 스튜디오 (예정) — GPT 대화·문구·이미지
OPENAI_API_KEY=

# KPI (민지) — Gemini VOC 요약: 변수 이름 확정 후 추가
ECOS_API_KEY=

# HOME (주연) — AI 오늘의 브리핑: 제공사·변수 이름 확정 후 추가
CALENDARIFIC_API_KEY=
DEEPL_API_KEY=